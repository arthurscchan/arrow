# Tokens for the arrow-ipc-stream-fuzz target: 8-byte option headers (see
# DecodeFuzzIpcHeader() in reader.cc) covering reader option combinations and
# write codecs/endianness for the round-trip write, plus IPC framing constants
# (magic, continuation marker, message frame prefix) so that mutations of
# truncated files can restore a parseable structure.

read-defaults="\xfa\x03\x00\x00\x00\x00\x00\x00"
read-no-swap="\xfa\x02\x00\x00\x00\x00\x00\x00"
read-no-threads="\xfa\x01\x00\x00\x00\x00\x00\x00"
read-project-first-field="\xfa\x0b\x00\x00\x00\x00\x00\x00"
read-project-two-fields="\xfa\x13\x00\x00\x00\x00\x00\x00"
read-depth1="\xfa\x03\x01\x00\x00\x00\x00\x00"
read-depth5="\xfa\x03\x02\x00\x00\x00\x00\x00"
read-depth100="\xfa\x03\x03\x00\x00\x00\x00\x00"
read-aligned64="\xfa\x03\x04\x00\x00\x00\x00\x00"
write-lz4="\xfa\x03\x00\x01\x00\x00\x00\x00"
write-zstd="\xfa\x03\x00\x02\x00\x00\x00\x00"
write-foreign-endian="\xfa\x03\x00\x00\x01\x00\x00\x00"
write-foreign-endian-zstd="\xfa\x03\x00\x02\x01\x00\x00\x00"
ipc-magic="\x41\x52\x52\x4f\x57\x31"
ipc-continuation="\xff\xff\xff\xff"
message-schema="\xff\xff\xff\xff\x98\x00\x00\x00"
message-recordbatch="\xff\xff\xff\xff\x9c\x00\x00\x00"
message-dictionary="\xff\xff\xff\xff\xa0\x00\x00\x00"
message-eos="\xff\xff\xff\xff\x00\x00\x00\x00"
